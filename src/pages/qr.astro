---
import Base from '../layouts/Base.astro';

/**
 * QR sign generator.
 *
 * Everything on the sheet is sized in inches and points. CSS pins those to
 * 96px/in on screen and to real physical units in print, so this one element is
 * simultaneously an accurate preview and a true-size print - there is no second
 * set of measurements anywhere.
 */
---

<Base
  title="QR signs — Seattle Makers"
  description="Generate a printable QR sign with a title and description."
  bodyClass="qr-page"
>
  <div class="qr-layout">
    {/* --------------------------------------------------------- editor --- */}
    <aside class="no-print qr-editor">
      <header class="qr-head">
        <a href="/" class="qr-back">← tools</a>
        <p class="qr-eyebrow">seattle makers</p>
        <h1>qr <span>signs</span></h1>
        <p class="qr-sub">Type a link, print a sign.</p>
      </header>

      <h2 class="qr-group">Content</h2>

      <label class="qr-field">
        <span>Link</span>
        <input
          id="f-url"
          type="text"
          inputmode="url"
          autocomplete="off"
          spellcheck="false"
          placeholder="seattlemakers.org/interest"
        />
      </label>
      <p id="f-url-note" class="qr-note" hidden></p>

      <label class="qr-field">
        <span>Eyebrow <i>the small line on top</i></span>
        <input id="f-eyebrow" type="text" maxlength="24" value="scan to" placeholder="scan to" />
      </label>

      <label class="qr-field">
        <span>Title <i>above the code</i></span>
        <input id="f-title" type="text" maxlength="60" placeholder="Join Seattle Makers" />
      </label>

      <label class="qr-field">
        <span>Description <i>below the code</i></span>
        <textarea
          id="f-desc"
          rows="3"
          maxlength="200"
          placeholder="Scan to tell us what you'd like to make."></textarea>
      </label>

      <h2 class="qr-group">Layout</h2>

      <fieldset class="qr-field">
        <legend>Size</legend>
        <div class="qr-seg" id="f-size">
          <button type="button" data-size="full" aria-pressed="true">Full page<i>7.25 × 10in</i></button>
          <button type="button" data-size="half" aria-pressed="false">Half<i>5 × 7.25in</i></button>
          <button type="button" data-size="card" aria-pressed="false">Card<i>3.625 × 5in</i></button>
        </div>
      </fieldset>

      <fieldset class="qr-field" id="f-copies-wrap">
        <legend>Copies per sheet</legend>
        <div class="qr-seg" id="f-copies">
          <button type="button" data-copies="1" aria-pressed="true">One<i>centered</i></button>
          <button type="button" data-copies="fill" aria-pressed="false">Fill sheet<i id="fill-n">—</i></button>
        </div>
      </fieldset>

      <label class="qr-check">
        <input id="f-cut" type="checkbox" />
        <span>Cut lines</span>
      </label>

      <label class="qr-check">
        <input id="f-showurl" type="checkbox" checked />
        <span>Print the link as text</span>
      </label>

      <p id="warn" class="qr-warn" hidden></p>

      <button id="f-print" type="button" class="qr-print" disabled>Print</button>
      <p class="qr-hint">
        In the print dialog: uncheck <b>Headers and footers</b>, and leave <b>Scale</b> at 100%, so the code comes out at true size.
      </p>
    </aside>

    {/* -------------------------------------------------------- preview --- */}
    <div class="qr-preview">
      <div class="pv-bar no-print">
        <span id="pv-paper" class="pv-paper">Letter &middot; 8.5 &times; 11in</span>
        <span id="pv-count" class="pv-count">1 sign</span>
        <span id="pv-zoom" class="pv-zoom">100%</span>
      </div>
      <div id="preview-host">
        <div id="paper" data-orient="portrait">
          <div id="page" data-orient="portrait">
            <div id="sheet" data-size="full" data-copies="1" data-cut="off"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* The piece is cloned from here by the script. Kept in markup rather than
      built in JS so the structure is readable next to the CSS that sizes it. */}
  <template id="piece-tpl">
    <div class="piece">
      <div class="p-head">
        <p class="p-eyebrow">
          <i class="p-eyerule"></i><span class="p-eyetext"></span><i class="p-eyerule"></i>
        </p>
        <p class="p-title"></p>
      </div>
      <div class="p-body">
        <div class="p-qr"></div>
        <p class="p-desc"></p>
      </div>
      <div class="p-foot">
        <span class="p-url"></span>
        <img class="p-mark" src="/brand/wordmark-black.png" alt="Seattle Makers" />
      </div>
    </div>
  </template>
</Base>

{/* Global, not scoped: Astro's scoped styles add a build-time data attribute
    that elements created by innerHTML/cloneNode never receive, so a scoped
    `.p-qr svg` rule would silently fail to match the injected code. */}
<style is:global>
  /* ===================================================== the printed page === */

  /* The sheet is the @page *content box*, never a full-bleed 8.5x11. Full bleed
     loses three ways: printers have a ~0.25in unprintable edge, Chrome's "fit to
     printable area" silently shrinks anything that overflows (which would
     destroy true size - the entire point), and a page-height element is the
     classic cause of a trailing blank page. */
  @page {
    size: letter portrait;
    margin: 0.5in;
  }

  /* Held inside the printable area of BOTH letter and A4 in each orientation,
     so nothing ever triggers a printer's shrink-to-fit:
       portrait  - A4 is 7.27in wide at 0.5in margins, so the grid is 7.25in
       landscape - A4 is 7.27in tall at 0.5in margins, so the grid is 7.25in */
  #page {
    background: #fff;
    color: #000;
    overflow: hidden;
  }
  #page[data-orient='portrait'] {
    width: 7.25in;
    height: 10in;
  }
  #page[data-orient='landscape'] {
    width: 10in;
    height: 7.25in;
  }

  #sheet {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    align-items: center;
  }

  #sheet[data-size='full'] {
    --piece-w: 7.25in; --piece-h: 10in;   --qr: 5.5in;
    --eyebrow: 12pt; --title: 52pt; --desc: 16pt; --url: 10.5pt; --markh: 0.32in;
    --track: 0.36em; --gap: 0.32in; --pad: 0.55in; --rule: 0.9pt;
    grid-template-columns: auto;
    gap: 0;
  }
  /* Two portrait half-letters side by side on a landscape sheet - the standard
     half-page flyer. Cutting the sheet once down the middle yields both. */
  #sheet[data-size='half'] {
    --piece-w: 5in; --piece-h: 7.25in;    --qr: 3in;
    --eyebrow: 8.5pt; --title: 26pt; --desc: 12pt; --url: 8pt; --markh: 0.24in;
    --track: 0.30em; --gap: 0.17in; --pad: 0.38in; --rule: 0.7pt;
    grid-template-columns: repeat(2, auto);
    gap: 0;
  }
  #sheet[data-size='half'][data-copies='1'] {
    grid-template-columns: auto;
  }
  /* 2x2 tiles the 7.25 x 10in grid exactly, with no gutter: adjacent cut lines
     land on top of each other, which is what you want when trimming a stack.
     A gutter here would not fit - 2 x 5in plus any gap exceeds the 10in sheet,
     and the grid silently squashes the cards rather than overflowing. */
  #sheet[data-size='card'] {
    --piece-w: 3.625in; --piece-h: 5in;   --qr: 2.25in;
    --eyebrow: 6pt; --title: 17pt; --desc: 8.5pt; --url: 6pt; --markh: 0.155in;
    --track: 0.24em; --gap: 0.12in; --pad: 0.28in; --rule: 0.6pt;
    grid-template-columns: repeat(2, auto);
    gap: 0;
  }
  /* A single card has no second column to sit beside. */
  #sheet[data-size='card'][data-copies='1'] {
    grid-template-columns: auto;
  }

  /* Three bands: masthead at the top, the code and its description filling the
     middle, an imprint line ruled off at the foot. Everything is black - the
     hierarchy is carried by size, weight, tracking and air, which is also what
     keeps it photocopyable. */
  .piece {
    width: var(--piece-w);
    height: var(--piece-h);
    padding: var(--pad);
    display: flex;
    flex-direction: column;
    text-align: center;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: #000;
  }
  #sheet[data-cut='on'] .piece {
    outline: 0.5pt dashed #999;
  }

  /* grow but never shrink, so text that does not fit overflows visibly and the
     script's scrollHeight check can catch it instead of it being squashed */
  .p-body {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap);
  }

  /* The eyebrow sits ON its rule, with the line breaking either side of it.
     Built from two flex-grown borders rather than a white knockout, because a
     knockout depends on background printing - which is off by default, and
     would print the rule straight through the words. */
  .p-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85em;
    margin-bottom: calc(var(--gap) * 0.55);
    font-family: var(--font-sans);
    font-size: var(--eyebrow);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    /* the tracking is the whole effect; without it this is just small text */
    letter-spacing: var(--track);
  }
  .p-eyerule {
    flex: 1;
    border-top: var(--rule) solid #000;
  }
  .p-eyetext {
    flex: none;
    /* letter-spacing adds a trailing space that breaks optical centring */
    text-indent: var(--track);
  }

  /* Fraunces against Lato: a display serif with real character carrying the
     title, the grotesque handling everything functional. One rule below only -
     the eyebrow's line already closes the masthead at the top. */
  .p-title {
    padding-bottom: calc(var(--gap) * 0.55);
    border-bottom: var(--rule) solid #000;
    font-family: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    font-size: var(--title);
    font-weight: 900;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 144;
    line-height: 0.98;
    letter-spacing: -0.018em;
    /* Evens the line lengths instead of filling greedily, which is what stops a
       two-word title from breaking as one long line and one orphan. */
    text-wrap: balance;
  }
  .p-desc {
    max-width: 26em;
    font-size: var(--desc);
    font-weight: 400;
    line-height: 1.35;
    text-wrap: balance;
  }

  .p-foot {
    display: flex;
    align-items: baseline;
    gap: 1em;
    padding-top: calc(var(--gap) * 0.5);
    border-top: var(--rule) solid #000;
    font-size: var(--url);
    line-height: 1.2;
  }
  /* The printed link is a courtesy for anyone who will not scan; past two lines
     it stops being readable and starts crowding the code. Clamp rather than
     let a long query string take over the piece. */
  .p-url {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-width: 0;
    text-align: left;
    font-weight: 700;
  }
  /* The seattlemakers.org logo, reproduced in one colour. */
  .p-mark {
    margin-left: auto;
    flex: none;
    height: var(--markh);
    width: auto;
    display: block;
  }

  .p-title:empty,
  .p-desc:empty,
  .p-url:empty {
    display: none;
  }
  /* Hide the whole eyebrow row, rules included, when there is no eyebrow text. */
  .p-eyebrow:has(.p-eyetext:empty) {
    display: none;
  }
  /* Nothing left in the masthead for a rule to close off. */
  .p-title:empty {
    border-bottom: 0;
  }

  .p-qr {
    width: var(--qr);
    height: var(--qr);
    flex: none;
  }
  .p-qr svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Nothing encoded yet. Screen-only wording: printing is blocked in this
     state, so it can never reach paper. */
  .p-qr.is-empty {
    border: 1px dashed #c8c8c8;
    border-radius: 6px;
  }
  @media screen {
    .p-qr.is-empty::after {
      content: 'your code appears here';
      display: grid;
      place-items: center;
      height: 100%;
      padding: 0 1rem;
      font-size: 11pt;
      font-weight: 700;
      text-align: center;
      color: #c0c0c0;
    }
  }

  /* ========================================================= screen only === */

  @media screen {
    /* qrcode's svg-tag renderer bakes in shape-rendering="crispEdges". That is
       right at 600dpi and wrong in a scaled-down preview, where it makes module
       rows visibly uneven - the code reads as corrupt when it is fine. */
    .p-qr svg {
      shape-rendering: geometricPrecision;
    }

    /* A faint dot grid, the scale of a cutting mat. Atmosphere for the tool
       without competing with the sheet, which is the only thing here that
       should read as paper. */
    body.qr-page {
      background-color: var(--color-sm-mist);
      background-image: radial-gradient(circle at 1px 1px, rgb(0 0 0 / 0.055) 1px, transparent 0);
      background-size: 22px 22px;
    }

    @keyframes qr-rise {
      from {
        opacity: 0;
        transform: translateY(9px);
      }
    }
    /* One orchestrated load rather than scattered micro-interactions. */
    .qr-editor > *,
    .qr-preview > * {
      animation: qr-rise 0.55s cubic-bezier(0.2, 0.75, 0.3, 1) backwards;
    }
    .qr-editor > *:nth-child(1) { animation-delay: 0.02s; }
    .qr-editor > *:nth-child(2) { animation-delay: 0.06s; }
    .qr-editor > *:nth-child(3) { animation-delay: 0.10s; }
    .qr-editor > *:nth-child(4) { animation-delay: 0.14s; }
    .qr-editor > *:nth-child(5) { animation-delay: 0.18s; }
    .qr-editor > *:nth-child(6) { animation-delay: 0.22s; }
    .qr-editor > *:nth-child(n + 7) { animation-delay: 0.26s; }
    .qr-preview > *:nth-child(1) { animation-delay: 0.12s; }
    .qr-preview > *:nth-child(2) { animation-delay: 0.18s; }

    @media (prefers-reduced-motion: reduce) {
      .qr-editor > *,
      .qr-preview > * {
        animation: none;
      }
    }

    .qr-layout {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      max-width: 78rem;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    @media (max-width: 62rem) {
      .qr-layout {
        flex-direction: column;
        /* stretch, not the flex-start inherited above: in a column container
           align-items governs width, and flex-start would size the preview to
           its own content and overflow a narrow window rather than scale. */
        align-items: stretch;
      }
      .qr-editor {
        position: static !important;
        width: 100% !important;
      }
      .qr-preview {
        width: 100%;
      }
    }

    .qr-preview {
      flex: 1 1 auto;
      min-width: 0;
    }
    #preview-host {
      position: relative;
    }

    /* The preview is the whole 8.5 x 11in sheet, not just the printable area,
       so the margin you get is the margin you see. #page sits inside it at its
       true position: 0.5in down, and centered in the 7.5in content box. */
    #paper {
      background: #fff;
      border-radius: 2px;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.16),
        0 12px 34px rgb(0 0 0 / 0.13);
      /* Geometric scale, not zoom: zoom re-lays-out text at the scaled size, so
         preview line breaks would diverge from print and it would stop being a
         preview. The trade is that the scaled box keeps its unscaled layout
         size, so the script sets #preview-host's height. */
      transform: scale(var(--preview-scale, 1));
      transform-origin: top left;
    }
    /* Padding is the real 0.5in @page margin plus the slack left by holding the
       grid to 7.25in for A4 safety, split evenly. */
    #paper[data-orient='portrait'] {
      width: 8.5in;
      height: 11in;
      padding: 0.5in 0.625in;
    }
    #paper[data-orient='landscape'] {
      width: 11in;
      height: 8.5in;
      padding: 0.625in 0.5in;
    }
    /* Where the printable area begins. Faint on purpose - it is a guide, and it
       must never read as something that prints. */
    #page {
      outline: 1px dashed rgb(0 0 0 / 0.13);
    }

    .pv-bar {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.7rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #8a8a8a;
    }
    .pv-count {
      color: var(--color-sm-green);
    }
    .pv-zoom {
      margin-left: auto;
      font-variant-numeric: tabular-nums;
    }
  }

  /* ============================================================== editor === */

  .qr-editor {
    position: sticky;
    top: 2rem;
    flex: 0 0 21rem;
    width: 21rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .qr-back {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-sm-green);
  }
  .qr-back:hover {
    text-decoration: underline;
  }
  /* The 4px green rule and the lowercase black lockup are the index page's
     signature; repeating them is what makes this read as the same site. */
  .qr-head {
    padding-bottom: 1.1rem;
    border-bottom: 4px solid var(--color-sm-green);
  }
  /* Text, not the wordmark raster: the index page builds its identity the same
     way, and it stays crisp at any size. */
  .qr-eyebrow {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #b0b0b0;
  }
  /* Same face the sheet prints in, so the tool looks like what it makes. */
  .qr-editor h1 {
    margin-top: 0.55rem;
    font-family: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    font-size: 2.7rem;
    font-weight: 900;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 144;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .qr-editor h1 span {
    color: var(--color-sm-green);
  }
  .qr-sub {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: #525252;
  }

  .qr-group {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a3a3a3;
  }
  .qr-group + .qr-field {
    margin-top: -0.4rem;
  }

  .qr-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .qr-field > span,
  .qr-field > legend {
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #404040;
  }
  .qr-field > span i,
  .qr-field > legend i {
    font-style: normal;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: #a3a3a3;
  }
  .qr-field input[type='text'],
  .qr-field textarea {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid #d4d4d4;
    border-radius: 0.4rem;
    background: #fff;
    font: inherit;
    font-size: 0.95rem;
    resize: vertical;
  }
  .qr-field input[type='text']:focus,
  .qr-field textarea:focus {
    outline: 2px solid var(--color-sm-green);
    outline-offset: -1px;
    border-color: transparent;
  }

  .qr-seg {
    display: flex;
    gap: 0.35rem;
  }
  .qr-seg button {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.4rem;
    border: 1px solid #d4d4d4;
    border-radius: 0.4rem;
    background: #fff;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.15;
    cursor: pointer;
  }
  .qr-seg button i {
    font-style: normal;
    font-weight: 400;
    font-size: 0.68rem;
    color: #a3a3a3;
  }
  .qr-seg button {
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      color 140ms ease,
      transform 140ms ease;
  }
  .qr-seg button:hover:not(:disabled) {
    border-color: var(--color-sm-green);
    transform: translateY(-1px);
  }
  .qr-seg button:active:not(:disabled) {
    transform: translateY(0);
  }
  .qr-seg button[aria-pressed='true'] {
    border-color: var(--color-sm-green);
    background: var(--color-sm-green);
    color: #fff;
  }
  .qr-seg button[aria-pressed='true'] i {
    color: rgb(255 255 255 / 0.75);
  }
  .qr-seg button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .qr-seg button:disabled:hover {
    border-color: #d4d4d4;
  }

  .qr-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }
  .qr-check input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-sm-green);
  }

  .qr-note,
  .qr-warn {
    margin-top: -0.5rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .qr-note {
    color: #737373;
  }
  .qr-warn {
    padding: 0.5rem 0.65rem;
    border-radius: 0.4rem;
    background: #fef3c7;
    color: #713f12;
  }
  .qr-warn[data-level='error'] {
    background: #fee2e2;
    color: #7f1d1d;
  }

  .qr-print {
    padding: 0.75rem;
    border: 0;
    border-radius: 0.4rem;
    background: var(--color-sm-green);
    color: #fff;
    font: inherit;
    font-size: 1rem;
    font-weight: 900;
    cursor: pointer;
  }
  .qr-print {
    transition:
      background-color 140ms ease,
      box-shadow 140ms ease,
      transform 140ms ease;
  }
  .qr-print:hover:not(:disabled) {
    background: var(--color-sm-green-dark);
    box-shadow: 0 6px 18px rgb(16 115 60 / 0.28);
    transform: translateY(-1px);
  }
  .qr-print:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: none;
  }
  .qr-print:disabled {
    background: #d4d4d4;
    cursor: not-allowed;
  }
  .qr-hint {
    font-size: 0.75rem;
    line-height: 1.4;
    color: #737373;
  }

  /* =============================================================== print === */

  @media print {
    .no-print,
    astro-dev-toolbar {
      display: none !important;
    }

    /* Two live landmines in this repo. global.css sets html{background:ink},
       which prints as a solid black page whenever "Background graphics" is
       ticked; Base.astro puts min-h-screen on body, which is 100vh in print and
       emits a blank second page. */
    html,
    body.qr-page {
      background: #fff !important;
      color: #000 !important;
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
      height: auto !important;
    }

    .qr-layout {
      display: block !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    #preview-host {
      width: auto !important;
      height: auto !important;
    }
    /* The sheet of paper is a screen affordance; on paper it IS the paper. */
    #paper {
      width: auto !important;
      height: auto !important;
      padding: 0 !important;
      background: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      transform: none !important;
    }
    #page {
      outline: none !important;
      transform: none !important;
      box-shadow: none !important;
      /* The grid is 7.25in inside a 7.5in content box (A4 safety); without this
         the whole 0.25in of slack lands on one edge. Portrait has the slack
         across the width, landscape down the height. */
      margin: 0 auto !important;
    }
    #page[data-orient='landscape'] {
      margin: 0.125in auto !important;
    }
  }
</style>

