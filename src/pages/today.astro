---
/**
 * What is on in the space today.
 *
 * Rendered at build time from the baked calendar, then refetched from
 * /events.json in the browser so a screen left up overnight is right in the
 * morning without anyone touching it. The build-time render is the floor: if
 * the fetch fails - no network, host down, a redeploy mid-request - the board
 * keeps showing the last known good day rather than going blank.
 */
import Base from '../layouts/Base.astro';
import { eventsOn, localDay, FETCHED_AT } from '../lib/events';

const day = localDay();
const initial = eventsOn(day);

const heading = new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});
---

<Base title="Today — Seattle Makers" description="What is on at Seattle Makers today.">
  <main class="mx-auto max-w-4xl px-6 py-12">
    <header class="border-b-4 border-sm-green pb-6">
      <a href="/" class="text-sm font-bold text-sm-green no-underline hover:underline">&larr; tools</a>
      <p class="mt-6 text-lg font-black tracking-tight text-neutral-400">seattle makers</p>
      <h1 class="t-display mt-1 text-6xl leading-none font-black text-sm-green">today</h1>
      <p id="t-date" class="mt-3 text-xl text-neutral-600">{heading}</p>
    </header>

    <!-- Server-rendered floor. today.ts replaces the contents on a successful
         fetch; if it never does, this is what stays on screen. -->
    <ol id="t-list" class="mt-8 space-y-3">
      {
        initial.map((e) => (
          <li class="t-row rounded-lg border border-neutral-300 bg-white p-5">
            <div class="flex items-baseline justify-between gap-4">
              <span class="t-time text-2xl font-black tabular-nums">{e.start.slice(11)}</span>
            </div>
            <h2 class="mt-1 text-xl font-bold">{e.title}</h2>
          </li>
        ))
      }
    </ol>

    <p id="t-empty" class="mt-8 rounded-lg border border-dashed border-neutral-400 p-8 text-center text-lg text-neutral-500" hidden={initial.length > 0}>
      Nothing on the calendar today.
    </p>

    <footer class="mt-10 border-t border-neutral-300 pt-4 text-sm text-neutral-500">
      <span id="t-status">calendar fetched {FETCHED_AT.slice(0, 10)}</span>
    </footer>
  </main>
</Base>

<style>
  /* Fraunces is already declared in global.css for /labels; reusing it here
     costs no extra download on a visit that has seen either page. */
  .t-display {
    font-family: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 144;
    letter-spacing: -0.02em;
  }
</style>

<script>
  import '../scripts/today';
</script>
