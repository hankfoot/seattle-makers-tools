---
/**
 * What is on in the space today, as a live board.
 *
 * Rendered at build time from the baked calendar, then refetched from
 * /api/events (or /events.json) in the browser so a screen left up overnight is
 * right in the morning without anyone touching it. The build-time render is the
 * floor: if the fetch fails - no network, host down, a redeploy mid-request -
 * the board keeps showing the last known good day rather than going blank.
 *
 * Rows carry a status - past / live / next / later - from lib/day-status.ts,
 * and scripts/today.ts re-stamps them on a timer so the board walks through
 * the day by itself with no network involved. A refetch changes *what* is on;
 * the clock changes *where* it stands.
 *
 * Name, title and description come from data/tools.ts, so this page and its
 * card on the index cannot disagree about what the tool is. The one thing that
 * does not follow that: the visible subtitle is the date, not the blurb. This
 * is a board on a wall - what someone standing in front of it needs under the
 * heading is which day they are looking at, and a description of the tool
 * would be telling them about the thing they are already using.
 */
import Base from '../layouts/Base.astro';
import { localDay } from '../lib/events';
import { toolById, pageTitle } from '../data/tools';

const TOOL = toolById('today');

const day = localDay();

const heading = new Date(`${day}T00:00:00`).toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
});
---

<Base title={pageTitle(TOOL)} description={TOOL.blurb} shellWidth="72rem">
  {/* Crumb and freshness stamp sit above the plate, so the green panel holds
      the title and the date and nothing else. Both are hidden in display mode -
      a wall board has nothing to navigate to. */}
  <div class="sm-crumb-row">
    <a class="sm-back" href="/">← All tools</a>
    <p id="t-status" class="sm-stamp">Checking the calendar…</p>
  </div>

  <main class="sm-sheet t-board">
    <header class="sm-hero">
      <h1 class="sm-h1">{TOOL.name}</h1>
      <p id="t-date" class="sm-lead">{heading}</p>
    </header>

    <!-- Empty on purpose. There is no longer a build-time render: the baked
         calendar it was drawn from only refreshed when somebody ran
         `npm run events`, so the "floor" it provided was a schedule from weeks
         earlier, shown as today until the first fetch replaced it. Better to
         show nothing for the moment it takes than something wrong.

         today.ts fills this, and says so if it cannot. -->
    <ol id="t-list" class="t-list"></ol>

    <p id="t-empty" class="t-empty">Checking the calendar…</p>

    {/* Filled by the fit pass when a display cannot show every row. */}
    <p id="t-more" class="t-more" hidden></p>
  </main>
</Base>

{/* Global, not scoped: today.ts builds rows with createElement in the browser,
    and Astro stamps its scoping attribute at build time - so a scoped rule
    would style the server-rendered floor and nothing that replaces it. Same
    trap as the injected QR on /labels. */}
<style is:global>
  /* The board's one structural idea: a rail of times down the left with the
     day's events hanging off it. A day is a real sequence, so the order is
     information and the rail is what makes it legible from across a room -
     you find the time first, then read across. */
  .t-list {
    border-top: 0;
  }

  .t-row {
    /* One number, so the rule and the column it divides can never drift. */
    --rail: clamp(6.5rem, 4.6rem + 5vw, 9.5rem);
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-sm-line);
  }

  /* The rail runs the full height of the row and down through the hairline
     into the next one, so the day reads as one continuous line with events
     hung off it. */
  .t-row::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: -1px;
    left: var(--rail);
    width: 2px;
    background: var(--color-sm-line);
  }

  /* Right-aligned against the rail, tabular, so every time ends on the same
     vertical and the column scans as a clock rather than as ragged text. */
  .t-time {
    padding-right: 1.5rem;
    text-align: right;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    color: var(--color-sm-ink);
    white-space: nowrap;
  }

  .t-body {
    padding-left: 1.5rem;
  }

  .t-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .t-kind,
  .t-flag,
  .t-badge {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    line-height: 1.6;
    text-transform: uppercase;
  }

  /* What kind of thing this is stays plain text: it is true of every row, so
     giving all of them a chip would be a wall of chips saying nothing. */
  .t-kind {
    color: var(--color-sm-green);
  }

  /* Whether you can still get in is the exception, so it gets the chip. On a
     board read from a few metres away a tinted block is findable at a glance
     in a way that another line of small tracked caps is not. */
  .t-flag {
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .t-flag.is-go {
    color: var(--color-sm-green-dark);
    background: var(--color-sm-wash);
  }
  .t-flag.is-mute {
    color: var(--color-sm-slate);
    background: var(--color-sm-mist);
  }
  .t-flag.is-off {
    color: var(--color-sm-alert);
    background: #fbeaea;
  }

  /* ------------------------------------------------- where the day stands ---

     Four states, and only two of them announce themselves. "Later" is the
     default and needs no decoration; "past" recedes rather than shouting. The
     two carrying what someone walking in actually wants - what is running, and
     what is next - get a badge. */

  .t-badge {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    color: #fff;
    background: var(--color-sm-green);
  }

  /* Outlined, not filled: "up next" is a smaller claim than "on now", and two
     solid green chips in a column would compete. */
  .t-row[data-status='next'] .t-badge {
    padding: 0.08rem 0.48rem;
    color: var(--color-sm-green-dark);
    background: transparent;
    border: 1px solid var(--color-sm-green-mid);
  }

  /* The live row is the only thing on the board with a filled green rail, so
     the eye lands on it before reading a word. */
  .t-row[data-status='live']::before {
    width: 3px;
    background: var(--color-sm-green);
  }

  .t-row[data-status='live'] .t-time {
    color: var(--color-sm-green-dark);
  }

  /* Finished, not gone. Someone who turns up late needs to see that they
     missed it, which a vanished row cannot tell them. */
  .t-row[data-status='past'] {
    opacity: 0.42;
  }

  .t-note {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-sm-slate);
  }

  .t-row[data-status='live'] .t-note {
    color: var(--color-sm-green-dark);
  }

  /* How far through the running session we are. Presentational only - the same
     fact is in .t-note as words, which is what a screen reader gets. */
  .t-progress {
    height: 4px;
    max-width: 22rem;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: var(--color-sm-wash);
    overflow: hidden;
  }

  .t-progress i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-sm-green);
    transition: width 600ms ease;
  }

  .t-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.25;
    color: var(--color-sm-ink);
  }

  .t-sum {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.4rem;
    max-width: 68ch;
    font-size: clamp(0.9rem, 0.84rem + 0.2vw, 1.05rem);
    line-height: 1.55;
    color: var(--color-sm-slate);
  }

  /* Cancelled stays on the board, dimmed - someone who came for it needs to
     see that it is off, not find no trace of it. */
  .t-row.is-off .t-time,
  .t-row.is-off .t-title {
    color: var(--color-sm-slate);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* An empty screen is an invitation, not a void. */
  .t-empty {
    margin-top: 2.25rem;
    padding: 3.5rem 1.5rem;
    border: 1px solid var(--color-sm-line);
    border-radius: 12px;
    background: var(--color-sm-mist);
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-sm-slate);
  }

  /* What the fit pass had to leave off. */
  .t-more {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  @media (max-width: 34rem) {
    .t-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    /* No column, so no rail to divide it. */
    .t-row::before {
      display: none;
    }
    .t-time {
      padding-right: 0;
      text-align: left;
    }
    .t-body {
      padding-left: 0;
    }
  }

  /* ======================================================== debug panel ===

     Behind ?debug=1 only. Deliberately styled as a tool rather than as part of
     the board: a fixed dark bar, and a red hairline across the top of the page
     whenever the clock is simulated, so a board left on a wall showing a made-up
     time can never be mistaken for the real thing. */

  .t-debug {
    position: fixed;
    z-index: 50;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: var(--color-sm-ink);
    color: #e6e8e7;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .t-debug-tag {
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: #b03a3a;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .t-debug-range {
    flex: 1 1 12rem;
    min-width: 8rem;
    accent-color: var(--color-sm-green-mid);
  }

  .t-debug-read {
    min-width: 5.5rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .t-debug-tally {
    color: #9aa3a0;
  }

  .t-debug-date {
    padding: 0.15rem 0.35rem;
    border: 1px solid #454a48;
    border-radius: 4px;
    background: #232827;
    color: inherit;
    font: inherit;
    color-scheme: dark;
  }

  .t-debug-live {
    padding: 0.25rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-sm-green);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* Unmissable while the clock is a lie. */
  html.t-simulated body::before {
    content: '';
    position: fixed;
    z-index: 60;
    inset: 0 0 auto 0;
    height: 4px;
    background: #b03a3a;
  }

  /* The panel is fixed, so the board has to stop above it. */
  html.t-tv .sm-sheet {
    padding-bottom: clamp(1rem, 2vh, 2rem);
  }

  /* =================================================== display (TV) mode ===

     A vertical screen showing the board full-bleed with nothing to scroll,
     which is the whole constraint. Everything here serves filling exactly one
     viewport: no page margin, no rounded plate, no crumb, no footer, and a
     list told to stop at the bottom edge rather than run past it.

     today.ts decides when this applies - ?tv=1 forces it on, ?tv=0 off,
     otherwise a large portrait viewport - and hides whatever will not fit. */

  html.t-tv,
  html.t-tv body {
    height: 100%;
    overflow: hidden;
  }

  html.t-tv .sm-crumb-row,
  html.t-tv .sm-footer {
    display: none;
  }

  html.t-tv .sm-sheet {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    max-width: none;
    margin: 0;
    padding: 0 clamp(1.5rem, 3vw, 3.5rem) clamp(1rem, 2vh, 2rem);
    border-radius: 0;
    box-shadow: none;
  }

  html.t-tv .sm-hero {
    flex: 0 0 auto;
    margin: 0 calc(clamp(1.5rem, 3vw, 3.5rem) * -1) clamp(1rem, 2.2vh, 2.25rem);
    padding: clamp(1.4rem, 3vh, 2.6rem) clamp(1.5rem, 3vw, 3.5rem);
    border-radius: 0;
  }

  /* The list owns whatever is left, and never more. */
  html.t-tv .t-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }

  html.t-tv .t-more {
    flex: 0 0 auto;
  }

  /* Sized off vh, not vw: on a portrait screen the scarce axis is vertical,
     so type that scales with width would overflow the very screen it is for. */
  html.t-tv .sm-h1 {
    font-size: clamp(2.6rem, 3.4vh, 4.6rem);
  }
  html.t-tv .sm-lead {
    font-size: clamp(1.1rem, 1.5vh, 2rem);
  }
  html.t-tv .t-row {
    --rail: clamp(8rem, 12vh, 15rem);
    padding: clamp(0.9rem, 1.8vh, 2rem) 0;
  }
  html.t-tv .t-time {
    font-size: clamp(1.3rem, 2vh, 2.6rem);
  }
  html.t-tv .t-title {
    font-size: clamp(1.5rem, 2.4vh, 3.2rem);
  }
  html.t-tv .t-sum {
    font-size: clamp(1rem, 1.4vh, 1.8rem);
  }
  html.t-tv .t-kind,
  html.t-tv .t-flag,
  html.t-tv .t-badge,
  html.t-tv .t-note {
    font-size: clamp(0.8rem, 1.1vh, 1.3rem);
  }
  html.t-tv .t-progress {
    height: 6px;
    max-width: none;
  }
</style>

<script>
  import '../scripts/today';
</script>
