---
import Base from '../layouts/Base.astro';
import { buildReel } from '../lib/reel';
import { FETCHED_AT, EVENTS, eventsOn, localDay } from '../lib/events';
import { studiosWithPhotos } from '../lib/photos';

const reel = buildReel();
const counts = {
  slides: reel.length,
  photos: reel.filter((s) => s.type === 'photo').length,
  events: reel.filter((s) => s.type === 'event').length,
  studios: studiosWithPhotos().length,
  today: eventsOn(localDay()).length,
};

const tools = [
  // Parked while the today board is built out. The page and its runtime are
  // untouched and /slideshow still serves - this only takes it off the index.
  // {
  //   name: 'Slideshow',
  //   href: '/slideshow',
  //   blurb:
  //     'A looping reel of studio photos and upcoming classes, built to run full-screen on a laptop at markets and tabling events.',
  //   meta: `${counts.slides} slides · ${counts.photos} photos · ${counts.events} events`,
  //   ready: true,
  // },
  {
    name: 'Today',
    href: '/today',
    blurb:
      'What is on in the space today - classes, certifications, open studio and tours - refreshing itself on a screen by the door.',
    meta: `${counts.today} today · live once deployed`,
    ready: true,
  },
  {
    name: 'Labels',
    href: '/labels',
    blurb:
      "Design one label - title, subtitle, optional QR - and print it onto the Label Station's sheets, skipping any that have already been peeled.",
    meta: '4 stocks · 2 to 20 per sheet',
    ready: true,
  },
];
---

<Base title="Seattle Makers Tools">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <header class="border-b-4 border-sm-green pb-8">
      <h1 class="text-5xl leading-none font-black tracking-tight">
        seattle makers <span class="text-sm-green">tools</span>
      </h1>
      <p class="mt-3 text-lg text-neutral-600">Small web tools for the space.</p>
    </header>

    <ul class="mt-10 space-y-4">
      {
        tools.map((t) => (
          <li>
            <a
              href={t.href}
              class="block rounded-lg border border-neutral-300 bg-white p-6 transition hover:border-sm-green hover:shadow-md"
            >
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-2xl font-black">{t.name}</h2>
                <span class="shrink-0 text-sm font-bold text-sm-green">open →</span>
              </div>
              <p class="mt-2 text-neutral-700">{t.blurb}</p>
              <p class="mt-3 font-mono text-xs text-neutral-500">{t.meta}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="mt-12 border-t border-neutral-300 pt-6 font-mono text-xs text-neutral-500">
      <p>
        {EVENTS.length} events on file, fetched {FETCHED_AT.slice(0, 10)} from seattlemakers.org.
        Refresh with <code class="rounded bg-neutral-200 px-1">npm run events</code>.
      </p>
      <p class="mt-1">{counts.studios} studios have photos. Add more in public/studios/.</p>
    </footer>
  </main>
</Base>
