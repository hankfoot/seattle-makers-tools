---
import Base from '../layouts/Base.astro';
import { TOOLS, SITE } from '../data/tools';

/**
 * The index is a door, not a dashboard.
 *
 * It carried counts, per-tool metadata and the command for refreshing the
 * calendar. None of that helped anyone choose between two tools, and all of it
 * lives somewhere it actually applies: the counts on the board itself, the
 * sheet sizes in the label tool's own controls, and `npm run events` in the
 * README. What is left is each tool's name and what it is for.
 *
 * The names and blurbs come from data/tools.ts, which each tool page reads too
 * - so a card and the page it opens cannot describe the same tool differently.
 */
---


<Base title={SITE.name} description={SITE.blurb} shellWidth="52rem">
  <main class="sm-sheet">
    <header class="sm-hero">
      <h1 class="sm-h1">{SITE.name}</h1>
      <p class="sm-lead">{SITE.blurb}</p>
    </header>

    <ul class="tools">
      {
        TOOLS.map((t) => (
          <li>
            <a href={t.href}>
              <span class="t-name">{t.name}</span>
              <span class="t-blurb">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .tools li {
    border-bottom: 1px solid var(--color-sm-line);
  }

  /* Nothing follows the list any more, so the last row's rule would be a line
     drawn under the bottom of the card. */
  .tools li:last-child {
    border-bottom: 0;
  }

  /* One column. With the meta gone there is nothing to sit opposite the name,
     so the grid that used to hold the two apart went with it. */
  .tools a {
    display: block;
    padding: 1.7rem 1.1rem;
    margin: 0 -1.1rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  /* A wash on the row rather than the old trick of shifting its left padding.
     Sliding the text sideways under the cursor drew the eye to the movement
     instead of to the row, and reflowed the blurb while you were reading it. */
  .tools a:hover {
    background: var(--color-sm-wash);
  }

  .t-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.018em;
    line-height: 1.1;
    color: var(--color-sm-ink);
    transition: color 140ms ease;
  }

  /* The arrow rides with the name rather than sitting in a corner of its own.
     A whole row that is a link does not also need the word "Open" in it -
     the hover and the arrow say it. */
  .t-name::after {
    content: '→';
    margin-left: 0.5rem;
    font-size: 1.05rem;
    color: var(--color-sm-green);
    transition: transform 160ms ease;
    display: inline-block;
  }

  .tools a:hover .t-name {
    color: var(--color-sm-green);
  }

  .tools a:hover .t-name::after {
    transform: translateX(4px);
  }

  .t-blurb {
    display: block;
    margin-top: 0.5rem;
    max-width: 58ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-sm-slate);
  }
</style>
