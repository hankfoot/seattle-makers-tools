---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Chrome-free full-bleed page (the reel). */
  bare?: boolean;
  /** Render the shared footer. Off for the reel, which is full-bleed. */
  chrome?: boolean;
  /**
   * Width of the masthead bar's contents and of any .sm-sheet below it, set
   * as a custom property so the two can never disagree. A tool page that
   * needs a wider working area passes one value and both follow.
   */
  shellWidth?: string;
  /**
   * Extra classes for <body>. Pass a literal string - Tailwind v4 scans source
   * text, so a class name assembled at runtime never gets generated.
   */
  bodyClass?: string;
}
const {
  title,
  description = 'Tools for Seattle Makers.',
  bare = false,
  chrome = !Astro.props.bare,
  shellWidth = '64rem',
  bodyClass = '',
} = Astro.props;

const body = bare
  ? 'bg-sm-ink overflow-hidden'
  : `min-h-screen bg-sm-mist text-sm-ink ${bodyClass}`.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* The brand kit's own "Flavicon" - the outlined green m - replacing a
        hand-drawn stand-in. The touch icon is the same mark flattened onto
        white, because iOS ignores alpha and paints transparency black. */}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1a1a" />
    {/* The reel is the one page still set in Lato, so it is the one page that
        preloads it. Everywhere else the single variable Roboto covers every
        weight the UI asks for. */}
    {
      bare ? (
        <>
          <link rel="preload" href="/fonts/lato-900.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/lato-700.woff2" as="font" type="font/woff2" crossorigin />
        </>
      ) : (
        <>
          <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
          <link rel="preload" href="/fonts/roboto.woff2" as="font" type="font/woff2" crossorigin />
        </>
      )
    }
  </head>
  <body class={body} style={`--sm-shell-w: ${shellWidth}`}>
    <slot />
    {chrome && <SiteFooter />}
  </body>
</html>
