---
/**
 * Schematic of the Interbay location, drawn in the flat grey/green style of the
 * map in the brand deck. That deck's map still points at the old Wallingford
 * space by Gas Works Park; this one points at 3012 16th Ave W.
 *
 * Deliberately simplified - at a market someone glances at this for two
 * seconds, so it carries the arterial (15th Ave W), the cross street
 * (W Dravus), and the address street, and little else.
 */
---

<svg
  viewBox="0 0 400 400"
  class="block h-full w-full"
  role="img"
  aria-label="Map of Seattle Makers at 3012 16th Ave W in Interbay, Seattle"
>
  <rect width="400" height="400" fill="#e6e6e6" />

  <!-- Interbay Golf Center, north-east of the space across 15th -->
  <rect x="316" y="0" width="84" height="70" fill="#10733c" />
  <text x="358" y="41" fill="#fff" font-size="12.5" font-weight="700" text-anchor="middle">
    Interbay
  </text>

  <!-- BNSF rail corridor along the west edge -->
  <rect x="0" y="0" width="34" height="400" fill="#d6d6d6" />
  <path d="M17 0 V400" stroke="#bcbcbc" stroke-width="3" stroke-dasharray="11 8" />

  <!-- streets -->
  <g stroke="#fff" fill="none" stroke-linecap="square">
    <path d="M300 0 V400" stroke-width="27" />
    <path d="M214 0 V400" stroke-width="15" />
    <path d="M140 0 V400" stroke-width="15" />
    <path d="M66 0 V400" stroke-width="15" />
    <path d="M0 84 H400" stroke-width="23" />
    <path d="M0 210 H400" stroke-width="15" />
    <path d="M0 322 H400" stroke-width="15" />
  </g>

  <!-- cross-street names, set just above their road -->
  <g fill="#3a3a3a" font-size="13" font-weight="700">
    <text x="44" y="76">W Dravus St</text>
    <text x="44" y="202">W Barrett St</text>
    <text x="44" y="314">W Armour St</text>
  </g>

  <!-- avenue names, dropped into the quiet band between Barrett and Armour -->
  <g fill="#3a3a3a" font-size="12.5" font-weight="700" text-anchor="middle">
    <text x="306" y="268" transform="rotate(-90 306 268)">15th Ave W</text>
    <text x="220" y="268" transform="rotate(-90 220 268)">16th Ave W</text>
    <text x="146" y="268" transform="rotate(-90 146 268)">17th Ave W</text>
    <text x="72" y="268" transform="rotate(-90 72 268)">20th Ave W</text>
  </g>

  <!-- the space: 3012 16th Ave W, between Dravus and Barrett -->
  <g>
    <path
      d="M214 132 l8.2 16.6 18.3 2.7-13.2 12.9 3.1 18.2-16.4-8.6-16.4 8.6 3.1-18.2-13.2-12.9 18.3-2.7z"
      fill="#f07f2a"
      stroke="#fff"
      stroke-width="2.6"
    />
    <text x="238" y="163" fill="#f07f2a" font-size="16" font-weight="900">MAKERSPACE</text>
  </g>
</svg>
