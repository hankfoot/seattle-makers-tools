---
/**
 * The site footer, and the only shared chrome on the page.
 *
 * There was a masthead above every page carrying the lockup and the product
 * name. It is gone: on a site with two tools it was a bar of identity with
 * nothing to do, and the crumb on each tool page already handles getting back
 * to the index.
 *
 * So the lockup moved down here and finishes the sentence - "built with love
 * by the community at" *[Seattle Makers]* - which is a better reason for a
 * logo to be on a page than "this is a website". It is desaturated and dropped
 * to 42% so it settles into the ground rather than sitting on top of it, and
 * comes back to full colour on hover, since it is a link.
 *
 * The artwork is the one-line "Skinny" variant. At this size that beats the
 * stacked lockup: stacked, a footer-sized mark puts "SEATTLE" on its own line
 * at about 9px, which goes fuzzy; strung out on one line the same overall area
 * buys letters roughly twice that height.
 *
 * NOTE: the repo link below 404s for anyone not signed in with access -
 * hankfoot/seattle-makers-tools is private as of this writing. The link is
 * correct and will work the moment the repo is made public or the viewer is a
 * collaborator; it is not a typo.
 */
const REPO = 'https://github.com/hankfoot/seattle-makers-tools';
---

<footer class="sm-footer no-print">
  <p>Built with <span class="sm-heart">❤️</span> by the community at</p>

  <a class="sm-footer-logo" href="https://seattlemakers.org" rel="noopener">
    <img src="/brand/wordmark-inline.png" alt="Seattle Makers" />
  </a>

  {/* Icon only, so it needs a name of its own - the mark is decorative. */}
  <a class="sm-footer-gh" href={REPO} rel="noopener" aria-label="Source code on GitHub">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
      ></path>
    </svg>
  </a>
</footer>
