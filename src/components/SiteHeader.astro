---
import { existsSync } from 'node:fs';

/**
 * The masthead, on every tool page.
 *
 * An identity strip, not a navigation bar: the logo, the name of the thing,
 * and the one link that leaves. Navigation lives on the page - the index *is*
 * the list of tools, and each tool page carries a single `.sm-back` to it.
 *
 * **The logo has two forms, and which one renders depends on a file.** The
 * one-line "SEATTLE makers" lockup is the right thing in a 48px bar, but the
 * only artwork in this repo is the stacked version (2048x634, and every copy
 * of it is that same 3.23:1 shape). Dropping the one-line lockup into
 * public/brand/wordmark-inline.png - or .svg, checked first - is all that is
 * needed: this picks it up at build time and sets it beside "Digital Toolbox".
 *
 * Until then it falls back to the monogram plus the full name as text, which
 * says the same thing and fits the same bar. The check is `existsSync` at
 * build rather than a runtime guess, so the output is one form or the other
 * with no broken image either way.
 *
 * Do NOT composite a one-line lockup out of the stacked one. The two words can
 * be cropped cleanly, but their spacing and relative size in the real inline
 * lockup are not derivable from the stacked arrangement, and a logo assembled
 * from guesses is a wrong logo.
 *
 * Styles live in global.css, not in a scoped block here, so the bar can be
 * reasoned about alongside the sheet it sits on.
 */
const INLINE = ['/brand/wordmark-inline.svg', '/brand/wordmark-inline.png'].find((p) =>
  existsSync(`public${p}`),
);
---

<header class="sm-masthead no-print">
  <div class="sm-masthead-inner">
    <a class="sm-brand" href="/">
      {
        INLINE ? (
          <>
            <img class="sm-lockup" src={INLINE} alt="Seattle Makers" />
            <span class="sm-brand-name sm-brand-product">Digital Toolbox</span>
          </>
        ) : (
          <>
            {/* Decorative: the title beside it already names the site, and a
                screen reader announcing "Seattle Makers" twice helps nobody. */}
            <img class="sm-mark" src="/brand/mark.png" alt="" />
            <span class="sm-brand-name">Seattle Makers <span>Digital Toolbox</span></span>
          </>
        )
      }
    </a>
    <a class="sm-nav-out" href="https://seattlemakers.org" rel="noopener">
      seattlemakers.org
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
